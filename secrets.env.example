# Build-time secrets for meta-own/recipes-core/images/own-image.bb.
# Copy this file OUTSIDE the repository (e.g. /work/rpi5-secrets.env),
# fill in the values and point conf/local.conf at it:
#
#   RPI5_SECRETS = "/work/rpi5-secrets.env"
#
# The file is read while do_rootfs runs, so its contents never enter the
# BitBake datastore, task signatures or sstate.
#
# Keep the single quotes: crypt hashes contain '$', which the shell
# would otherwise try to expand.

# Generate with: mkpasswd -m sha-512   (or: openssl passwd -6)
ROOT_PASSWORD_HASH='$6$CHANGE_ME_SALT$CHANGE_ME_HASH'

WIFI_SSID='YOUR_SSID'
WIFI_PASSWORD='YOUR_WIFI_PASSWORD'
# Alternatively, a precomputed PSK instead of WIFI_PASSWORD:
# WIFI_PSK='64_HEX_DIGITS'

# Optional, default UA
# WIFI_COUNTRY='UA'
